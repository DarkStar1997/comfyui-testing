# syntax=docker/dockerfile:1
FROM pytorch/pytorch:2.14.0-cuda13.2-cudnn9-devel

ARG TORCHAUDIO_VERSION=2.11.0
ARG TORCH_CUDA_ARCH_LIST=8.9

RUN apt-get update && apt-get install -y --no-install-recommends \
        git build-essential python3.12-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv --system-site-packages /opt/venv
ENV PATH=/opt/venv/bin:$PATH TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST}

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip setuptools wheel cmake ninja \
    && git clone --depth 1 --branch v${TORCHAUDIO_VERSION} https://github.com/pytorch/audio /tmp/audio \
    && cd /tmp/audio \
    && pip wheel --no-deps --no-build-isolation --wheel-dir /dist . \
    && rm -rf /tmp/audio
